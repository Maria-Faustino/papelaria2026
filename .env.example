DB_TEST_USERNAME=papelaria_app
DB_TEST_PASSWORD=postdba

# Banco descartável usado para comparar o esquema com as classes JPA
DB_DIFF_URL=jdbc:postgresql://localhost:5432/papelaria_diff
DB_DIFF_USERNAME=papelaria_app
DB_DIFF_PASSWORD=postdba

# Banco descartável criado pelo Hibernate a partir das classes JPA
DB_REFERENCE_URL=jdbc:postgresql://localhost:5432/papelaria_reference
DB_REFERENCE_USERNAME=papelaria_app
DB_REFERENCE_PASSWORD=postdba

# Profile de produção (exemplo sem valores reais)
DB_URL=jdbc:postgresql://servidor:5432/papelaria
