{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-papelaria0001",
    "name": "Papelaria API",
    "description": "Collection pronta para a API de estoque da papelaria.\n\nOrdem sugerida:\n1. Health\n2. Cadastrar Categoria\n3. Cadastrar Fornecedor\n4. Cadastrar Produto\n5. Listagens e buscas por ID\n\nOs POSTs gravam automaticamente `categoriaId`, `fornecedorId` e `produtoId` nas variáveis da collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "categoriaId",
      "value": "1"
    },
    {
      "key": "fornecedorId",
      "value": "1"
    },
    {
      "key": "produtoId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Confirma se a API está no ar. Resposta esperada: OK"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Categorias",
      "item": [
        {
          "name": "POST Cadastrar Categoria",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    if (body.id) {",
                  "        pm.collectionVariables.set('categoriaId', String(body.id));",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Escolar\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/categorias",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categorias"]
            },
            "description": "Cadastra uma categoria e salva o id em {{categoriaId}}."
          },
          "response": []
        },
        {
          "name": "GET Listar Categorias",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/categorias",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categorias"]
            }
          },
          "response": []
        },
        {
          "name": "GET Buscar Categoria por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/categorias/{{categoriaId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categorias", "{{categoriaId}}"]
            }
          },
          "response": []
        }
      ]
    },
